   "source": [
    "p=[]\n",
    "num=100\n",
    "for num in range(2,num+1):\n",
    "    prime=True\n",
    "    for i in range(2,int(num/2)+1):\n",
    "        if num%i==0:\n",
    "            prime=False\n",
    "            break\n",
    "    if prime:\n",
    "        p.append(num)\n",
    "print(p)\n"
   ]
